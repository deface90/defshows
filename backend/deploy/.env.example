# Copy to .env and fill in. Never commit the real .env.

# ---- Postgres ----
POSTGRES_USER=defshows
POSTGRES_PASSWORD=defshows
POSTGRES_DB=defshows
POSTGRES_PORT=5432
# DSN for the app services INSIDE docker compose → host = the `postgres` service name.
# For host-side tooling (`make migrate-*`, `go run ./cmd/...`) switch host to localhost:5432.
DB_DSN=postgres://defshows:defshows@postgres:5432/defshows?sslmode=disable

# ---- MinIO (S3) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=defshows
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Internal endpoint for app services inside compose (host = `minio` service name);
# use localhost:9000 for host-side tooling.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=defshows
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Browser-reachable base URL of the web API that serves mirrored images. Posters
# of tracked shows are mirrored into MinIO and served as <base>/images/<key>, so
# the browser never hits the (blockable) TMDB image host. Usually equals
# FRONTEND_API_BASE_URL. When S3_* is unset, images fall back to raw TMDB URLs.
IMAGE_PUBLIC_BASE_URL=http://localhost:8080

# ---- Auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Seed (optional) ----
# If both set, `web` creates this admin on startup (idempotent — existing email untouched).
# Leave blank to skip seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Where the SPA lives (OAuth handoff redirect target) — the frontend service below
FRONTEND_URL=http://localhost:3000

# ---- Email (SMTP) ----
# Used to deliver password-reset links (${FRONTEND_URL}/reset-password?token=...).
# If SMTP_HOST / SMTP_FROM are unset, mail is NOT sent — the reset link is logged
# by the `web` service instead (fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Service ports ----
# Host ports. Leave unset to use per-compose defaults: WEB_PORT is 8080 in dev
# (docker-compose.yml) and 8088 in prod (docker-compose.prod.yml, the only
# published backend port). Uncomment to pin an explicit port for both.
# WEB_PORT=8080
AUTH_PORT=8081

# ---- Container images (docker-compose.prod.yml) ----
# Pre-built images pushed by CI (.github/workflows/build-images.yml). Pin a tag
# (e.g. :v1.2.3 or :sha-abc123) for reproducible prod deploys.
BACKEND_IMAGE=ghcr.io/deface90/defshows-backend:latest
FRONTEND_IMAGE=ghcr.io/deface90/defshows-frontend:latest

# Browser origins allowed to call the API (comma-separated). Add your SPA origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Frontend (SPA) ----
# Host port for the nginx-served SPA
FRONTEND_PORT=3000
# Browser-reachable base URL of the web API, baked into env.js at container start
# Production compose publishes web on 8088 by default. For a remote deployment,
# set this to the public API URL and update FRONTEND_URL / CORS_ALLOWED_ORIGINS.
FRONTEND_API_BASE_URL=http://localhost:8088
# App Store link shown on the frontend once the iOS app is published (e.g.
# https://apps.apple.com/app/id6814790859). Leave empty to hide the link.
FRONTEND_APP_STORE_URL=

# ---- External data providers ----
# TMDB API key (v3), not the API Read Access Token.
TMDB_API_KEY=
TMDB_LANGUAGE=ru-RU
OMDB_API_KEY=

# ---- Outbound proxy ----
# Optional: route ALL blockable outbound traffic (Telegram Bot API, TMDB API,
# image downloads, including /images/tmdb/* requested by browsers) through a proxy. Supports socks5:// (incl. auth) and http(s)://.
# Example: socks5://user:pass@127.0.0.1:1080
# (Supersedes the old TELEGRAM_PROXY_URL, still read as a fallback.)
PROXY_URL=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- APNs (iOS push notifications) ----
# From developer.apple.com -> Certificates, Identifiers & Profiles -> Keys.
# APNS_KEY is the full contents of the downloaded .p8 file.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY=
APNS_TOPIC=com.defshows.ios
# false while testing against Xcode Debug builds (sandbox gateway); true for
# TestFlight/App Store builds.
APNS_PRODUCTION=true

# ---- FCM (Android push notifications) ----
# From console.firebase.google.com -> Project Settings -> Service Accounts ->
# Generate new private key. FCM_SERVICE_ACCOUNT is the full contents of the
# downloaded JSON key; FCM_PROJECT_ID is the project id shown on that page.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=

# ---- OAuth (redirect URIs point at the auth service callback) ----
# Public base URL of the auth/web service (used to build the provider callback):
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=

# Copy to .env and fill in. Never commit the real .env.

# ---- Postgres ----
POSTGRES_USER=defshows
POSTGRES_PASSWORD=defshows
POSTGRES_DB=defshows
POSTGRES_PORT=5432
# DSN for the app services INSIDE docker compose → host = the `postgres` service name.
# For host-side tooling (`make migrate-*`, `go run ./cmd/...`) switch host to localhost:5432.
DB_DSN=postgres://defshows:defshows@postgres:5432/defshows?sslmode=disable

# ---- MinIO (S3) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=defshows
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Internal endpoint for app services inside compose (host = `minio` service name);
# use localhost:9000 for host-side tooling.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=defshows
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Seed (optional) ----
# If both set, `web` creates this admin on startup (idempotent — existing email untouched).
# Leave blank to skip seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Where the SPA lives (OAuth handoff redirect target) — the frontend service below
FRONTEND_URL=http://localhost:3000

# ---- Service ports ----
# Host ports. Leave unset to use per-compose defaults: WEB_PORT is 8080 in dev
# (docker-compose.yml) and 8088 in prod (docker-compose.prod.yml, the only
# published backend port). Uncomment to pin an explicit port for both.
# WEB_PORT=8080
AUTH_PORT=8081

# ---- Container images (docker-compose.prod.yml) ----
# Pre-built images pushed by CI (.github/workflows/build-images.yml). Pin a tag
# (e.g. :v1.2.3 or :sha-abc123) for reproducible prod deploys.
BACKEND_IMAGE=ghcr.io/deface90/defshows-backend:latest
FRONTEND_IMAGE=ghcr.io/deface90/defshows-frontend:latest

# Browser origins allowed to call the API (comma-separated). Add your SPA origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Frontend (SPA) ----
# Host port for the nginx-served SPA
FRONTEND_PORT=3000
# Browser-reachable base URL of the web API, baked into env.js at container start
FRONTEND_API_BASE_URL=http://localhost:8080

# ---- External data providers ----
TMDB_API_KEY=
TMDB_LANGUAGE=ru-RU
OMDB_API_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- OAuth (redirect URIs point at the auth service callback) ----
# Public base URL of the auth/web service (used to build the provider callback):
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
